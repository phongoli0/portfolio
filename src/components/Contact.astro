---
import { contact } from '../data/content';

const halves = contact.form.fields.filter((f) => f.half);
const full = contact.form.fields.filter((f) => !f.half);
---

<section class="section contact" id="contact">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2>{contact.title}</h2>
      <p>{contact.subtitle}</p>
    </div>

    <div class="contact__grid">
      <div class="contact__details" data-reveal>
        <ul>
          {
            contact.details.map((item) => (
              <li>
                <span class="contact__label">{item.label}</span>
                {item.href ? <a href={item.href}>{item.value}</a> : <span>{item.value}</span>}
              </li>
            ))
          }
        </ul>
      </div>

      <form
        class="contact__form"
        id="contact-form"
        name={contact.form.name}
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-reveal
        style="--reveal-delay:60"
      >
        <input type="hidden" name="form-name" value={contact.form.name} />
        <p class="hidden">
          <label>Don’t fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        {
          halves.map((field) => (
            <p class="field">
              <label for={field.id}>{field.label}</label>
              <input
                id={field.id}
                name={field.name}
                type={field.type}
                autocomplete={field.autocomplete}
                required
              />
            </p>
          ))
        }

        {
          full.map((field) => (
            <p class="field field--full">
              <label for={field.id}>{field.label}</label>
              <textarea id={field.id} name={field.name} rows={5} required />
            </p>
          ))
        }

        <div class="contact__submit">
          <button class="button button--primary" id="sendMessageButton" type="submit">Send message</button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
  }

  .contact__details ul {
    display: grid;
    gap: 22px;
  }

  .contact__details li {
    display: grid;
    gap: 4px;
  }

  .contact__label {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .contact__details a,
  .contact__details li > span:last-child {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }

  @media (pointer: coarse) {
    .contact__details a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  .contact__details a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: rgb(227 135 45 / 35%);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-ui) var(--ease-out);
  }

  .contact__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field label {
    font-size: var(--step--1);
    color: var(--text-3);
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-field);
    background: var(--elevated);
    color: var(--text);
    transition:
      border-color var(--dur-ui) var(--ease-out),
      background-color var(--dur-ui) var(--ease-out);
  }

  .field textarea {
    min-height: 132px;
    resize: vertical;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--text-3);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .contact__submit {
    grid-column: 1 / -1;
    margin-top: 6px;
  }

  .contact__submit button {
    width: 100%;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact__details a:hover {
      text-decoration-color: currentColor;
    }
  }

  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    }

    .contact__submit button {
      width: auto;
      min-width: 200px;
    }
  }

  @media (max-width: 560px) {
    .contact__form {
      grid-template-columns: 1fr;
    }
  }
</style>
