---
import { nav, site } from '../data/content';
---

<header class="nav" data-nav>
  <div class="nav__edge" aria-hidden="true"></div>
  <div class="container nav__inner">
    <a class="nav__brand" href="#home">{site.name}</a>

    <nav class="nav__links" aria-label="Sections">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="nav__resume" href={site.resume} target="_blank" rel="noopener">Résumé</a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-sheet" data-nav-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="nav__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="nav__sheet" id="nav-sheet" data-nav-sheet hidden>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} data-nav-sheet-link>
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href={site.resume} target="_blank" rel="noopener">Résumé</a></li>
    </ul>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-height);
    background: rgb(0 0 0 / 72%);
    backdrop-filter: blur(20px) saturate(180%);
  }

  /* Scroll edge effect: no hard divider, a soft mask where content meets chrome. */
  .nav__edge {
    position: absolute;
    inset: auto 0 -14px;
    height: 14px;
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(255 255 255 / 7%), transparent);
    opacity: 0;
    transition: opacity var(--dur-ui) var(--ease-out);
  }

  .nav[data-scrolled] .nav__edge {
    opacity: 1;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 100%;
  }

  .nav__brand {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .nav__links {
    margin-inline: auto;
  }

  .nav__links ul {
    display: flex;
    gap: clamp(16px, 2.2vw, 34px);
  }

  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 0.8125rem;
    color: var(--text-2);
    transition: color var(--dur-ui) var(--ease-out);
  }

  .nav__links a[aria-current='true'] {
    color: var(--text);
  }

  .nav__resume {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 6px 16px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    transition:
      border-color var(--dur-ui) var(--ease-out),
      background-color var(--dur-ui) var(--ease-out);
  }

  .nav__toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    place-items: center;
  }

  .nav__bars {
    display: grid;
    gap: 6px;
    width: 20px;
  }

  .nav__bars i {
    display: block;
    height: 1.5px;
    background: var(--text);
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .nav__toggle[aria-expanded='true'] .nav__bars i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__bars i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .nav__sheet {
    position: absolute;
    inset: 100% 0 auto;
    padding: 12px var(--gutter) 28px;
    background: rgb(0 0 0 / 92%);
    backdrop-filter: blur(24px) saturate(180%);
    transform-origin: top center;
    animation: sheet-in var(--dur-ui) var(--ease-out) both;
  }

  .nav__sheet[hidden] {
    display: none;
  }

  .nav__sheet a {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-size: 1.0625rem;
    border-bottom: 1px solid var(--hairline);
  }

  .nav__sheet li:last-child a {
    border-bottom: 0;
    color: var(--accent);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.99);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__links a:hover {
      color: var(--text);
    }

    .nav__resume:hover {
      border-color: rgb(255 255 255 / 32%);
      background: rgb(255 255 255 / 4%);
    }
  }

  @media (max-width: 860px) {
    .nav__links,
    .nav__resume {
      display: none;
    }

    .nav__toggle {
      display: grid;
      margin-inline-start: auto;
    }

    .nav__inner {
      gap: 0;
    }
  }
</style>
