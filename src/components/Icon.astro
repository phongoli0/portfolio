---
/** Inline SVG so currentColor tints the artwork. */
import { serviceIcons, cleanSvg } from '../data/icons';

interface Props {
  name: string;
  class?: string;
  size?: number;
}

const { name, class: className, size = 28 } = Astro.props;

const brand: Record<string, string> = {
  linkedin:
    '<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05a4.17 4.17 0 0 1 3.75-2.06c4 0 4.4 2.63 4.4 6.05V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.91V21h-4z"/>',
  github:
    '<path d="M12 .5a11.5 11.5 0 0 0-3.64 22.42c.58.1.79-.25.79-.55v-2.1c-3.2.7-3.88-1.4-3.88-1.4-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.19a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.19 3.17-1.19.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.26 5.69.42.36.79 1.06.79 2.14v3.17c0 .3.21.66.8.55A11.5 11.5 0 0 0 12 .5z"/>',
};

const markup = brand[name]
  ? `<svg viewBox="0 0 24 24">${brand[name]}</svg>`
  : cleanSvg(serviceIcons[name] ?? '');
---

<span
  class:list={['icon', className]}
  style={`--icon-size:${size}px`}
  aria-hidden="true"
  set:html={markup}
/>

<style>
  .icon {
    display: inline-grid;
    place-items: center;
    width: var(--icon-size);
    height: var(--icon-size);
    flex: none;
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
    max-width: 100%;
    fill: currentColor;
  }
</style>
