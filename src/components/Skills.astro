---
import { Image } from 'astro:assets';
import { skills } from '../data/content';
import { logoFiles } from '../data/logos';
---

<section class="section section--surface skills" id="skills">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{skills.eyebrow}</p>
      <h2>{skills.title}</h2>
      <p>{skills.subtitle}</p>
    </div>

    <ul class="skills__grid">
      {
        skills.logos.map((logo, i) => (
          <li class="skills__item" data-reveal style={`--reveal-delay:${i * 40}`}>
            <Image
              src={logoFiles[logo.file]}
              alt=""
              class:list={['logo', logo.mono && 'is-mono']}
              widths={[44, 88]}
              sizes="44px"
              formats={['webp']}
              quality={90}
              loading="lazy"
            />
            <span>{logo.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .skills__item {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 14px;
    min-height: 132px;
    padding: 22px 14px;
    background: var(--elevated);
  }

  .skills__item :global(img) {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  /* Marks whose artwork is dark-on-transparent would disappear on the dark tile. */
  .skills__item :global(img.is-mono) {
    filter: brightness(0) invert(1);
    opacity: 0.82;
  }

  .skills__item span {
    font-size: var(--step--1);
    letter-spacing: -0.005em;
    color: var(--text-2);
    text-align: center;
  }

  @media (max-width: 900px) {
    .skills__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .skills__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .skills__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
