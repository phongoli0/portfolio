---
import Icon from './Icon.astro';
import { services } from '../data/content';
---

<section class="section section--surface section--tight services" id="services">
  <div class="container">
    <div class="services__head" data-reveal>
      <h2>{services.title}</h2>
      <p>{services.subtitle}</p>
    </div>

    <ul class="services__list">
      {
        services.items.map((item, i) => (
          <li class="services__row" data-reveal style={`--reveal-delay:${i * 35}`}>
            <Icon name={item.icon} size={20} class="services__icon" />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__head {
    margin-bottom: clamp(24px, 3vw, 34px);
  }

  .services__head h2 {
    font-size: var(--step-heading);
  }

  .services__head p {
    margin-top: 12px;
    max-width: 46ch;
    font-size: var(--step-0);
    color: var(--text-2);
  }

  .services__list {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .services__row {
    display: grid;
    grid-template-columns: 20px minmax(0, 17rem) minmax(0, 1fr);
    gap: 10px clamp(16px, 2.2vw, 32px);
    align-items: baseline;
    padding-block: 13px;
    border-bottom: 1px solid var(--hairline);
  }

  .services__icon {
    color: var(--accent);
    align-self: start;
    transform: translateY(3px);
  }

  .services__row h3 {
    font-size: var(--step-0);
    letter-spacing: -0.01em;
  }

  .services__row p {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--text-2);
  }

  @media (max-width: 760px) {
    .services__row {
      grid-template-columns: 20px minmax(0, 1fr);
      row-gap: 6px;
    }

    /* Description drops under the title, keeping the icon in its own column. */
    .services__row p {
      grid-column: 2;
    }
  }
</style>
